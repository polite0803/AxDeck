<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AxDeck.BoxVerify</AssemblyName>
    <RootNamespace>AxDeck.BoxVerify</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AxDeck.Core\AxDeck.Core.csproj" />
    <Compile Include="..\..\src\AxDeck\Native\ShellDesktopIcons.cs" Link="ShellDesktopIcons.cs" />
    <Compile Include="..\..\src\AxDeck\Native\ShellFileOperations.cs" Link="ShellFileOperations.cs" />
    <Compile Include="..\..\src\AxDeck\Native\ShellShortcuts.cs" Link="ShellShortcuts.cs" />
    <Compile Include="..\..\src\AxDeck\BoxService.cs" Link="BoxService.cs" />
    <Compile Include="..\..\src\AxDeck\BoxTransferExecutor.cs" Link="BoxTransferExecutor.cs" />
  </ItemGroup>
</Project>
